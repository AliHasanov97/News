@model SonXeber.WebUI.ViewModels.NewsViewModel

@{
    ViewData["Title"] = "Xəbəri Sil";
}

<h2>Xəbəri Sil</h2>

<h4>Bu xəbəri silmək istədiyinizə əminsiniz?</h4>

<div class="mb-3">
    <strong>Başlıq:</strong> @Model.Title
</div>

<div class="mb-3">
    <strong>Məzmun:</strong><br />
    <div class="border p-2">@Model.Content</div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>
